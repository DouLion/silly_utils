void Process()
{
    const int TIME_SPAN = 5 * 60;
    std::time_t now = std::time(nullptr) - TIME_SPAN * 3;  // 往前倒一会儿, 防止数据延迟
    now = now / TIME_SPAN * TIME_SPAN;                     // 取整5分钟

    // now = sutime("2025-05-22 01:00").stamp();
    std::map<int, std::map<int, double>> lon2lat2drp = GetDrpData(now);
    std::map<std::string, std::vector<WarningRec>> adcd2warns;
    {  // 先处理危险区的预警
        std::vector<WarningRec> warns = WxqWarns(lon2lat2drp);

        for (const auto& warn : warns)
        {
            adcd2warns[WXQ2XIAN[warn.CODE]].push_back(warn);
        }
    }

    if (adcd2warns.empty())
    {
        SLOG_INFO("当前无预警产生。")
        return;
    }

    std::time_t warnTM = std::time(nullptr);
    warnTM = warnTM / SEC_IN_HOUR * SEC_IN_HOUR;
    std::vector<WarningRec> warns;
    for (auto& [adcd, wxqWarns] : adcd2warns)
    {
        std::set<std::string> xiangCodes;
        Json::Value jvTmp = Json::objectValue;
        Json::Value jvDetails = Json::arrayValue;

        double MaxRate = MaxValue(adcd, lon2lat2drp);

        WarningRec tmp;
        tmp.CODE = adcd;
        for (const auto& warn : wxqWarns)
        {
            xiangCodes.insert(WXQ2XIANG[warn.CODE]);
            jvDetails.append(warn.jsonify());
        }
        tmp.WarnNM = XIAN2NAME[adcd] + "雷达短临预警";
        std::string xiangNames;
        for (const auto& xiangcd : xiangCodes)
        {
            xiangNames.append(XIANG2NAME[xiangcd]);
            if (xiangcd != *xiangCodes.rbegin())
            {
                xiangNames.append("、");
            }
        }
        tmp.WarnDesc = SUFMT(TEMPLATE, XIAN2NAME[adcd], MaxRate, xiangNames);
        jvTmp["details"] = jvDetails;
        jvTmp["code"] = adcd;
        jvTmp["name"] = tmp.WarnNM;
        jvTmp["time"] = TimeStringify(warnTM);
        tmp.attr = sujson::stringify(jvTmp, 8);
        warns.push_back(tmp);
    }

    SLOG_INFO("去重完毕，最终需入库 {}", warns.size());
    Insert(warns, warnTM);
}

