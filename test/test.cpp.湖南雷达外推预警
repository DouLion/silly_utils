    int WarnGradeID = -1;
    std::string WarnNM;
    std::string WarnDesc;
    std::string Name;
    double Threshold = 0.0;
    double WarningVal = 0.0;
    double Lon = 0;
    double Lat = 0;
    std::string attr;
    Json::Value jsonify() const
    {
        Json::Value ret = Json::objectValue;
        ret["code"] = CODE;
        ret["grade"] = WarnGradeID;
        ret["name"] = Name;
        ret["threshold"] = SUFMT("{:.1f}", Threshold);
        ret["drp"] = SUFMT("{:.1f}", WarningVal);
        ret["lon"] = Lon;
        ret["lat"] = Lat;
        return ret;
    }
};

