std::map<int, std::map<int, double>> GetDrpData(const std::time_t& tm)
{
    std::map<int, std::map<int, double>> ret;
    ReqParam param;
    sutime ptm(tm);
    param.btm = SUFMT("{:04d}-{:02d}-{:02d}%20{:02d}:{:02d}", ptm.year(), ptm.month(), ptm.day(), ptm.hour(), ptm.minute());
    param.etm = param.btm;
    suHttpClient cli;
    std::string resp;
    std::string url = URL;
    url.append("?").append(param.UrlFormat());
    SLOG_INFO("请求:{}", url)
    if (!cli.get(url, resp))
    {
        SLOG_ERROR(cli.err());
        return ret;
    }

    Json::Value jv = sujson::parse(resp);
    if (!jv.isObject())
    {
        SLOG_ERROR("JSON response is not an object");
        return ret;
    }

    // 检查状态码
    if (jv["status"].asInt() != 1 || !jv.isMember("data"))
    {
        std::string msg = jv.isMember("message") ? jv["message"].asString() : "unknown error";
        SLOG_ERROR("Radar API status error: {}", msg);
        return ret;
    }

    const Json::Value& data_arr = jv["data"];
    if (!data_arr.isArray())
    {
        SLOG_ERROR("Radar data is not an array");
        return ret;
    }

    for (const Json::Value& item : data_arr)
    {
        if (!item.isMember("lgtd") || !item.isMember("lttd") || !item.isMember("value"))
            continue;
        double rainfall = item["value"].asDouble() * SCALE;
        if (rainfall < 20)
        {
            continue;
        }
        double lon = item["lgtd"].asDouble();
        double lat = item["lttd"].asDouble();

        int iLon = static_cast<int>(std::round(lon * 100.0));
        int iLat = static_cast<int>(std::round(lat * 100.0));
        ret[iLon][iLat] = rainfall;
    }

    // 可选：记录解析条目数
    SLOG_INFO("解析数量{}", data_arr.size())

    return ret;
}

double MaxValue(const std::string& xian, const std::map<int, std::map<int, double>>& lon2lat2drp)
{
    double ret = 0;
    auto& mpoly = XIAN2POLY[xian];
    for (const auto& [lon, xx] : lon2lat2drp)
    {
        for (const auto& [lat, drp] : xx)
        {
            if (drp < 20)
            {
                continue;
            }
            double dLon = lon * 0.01;
            double dLat = lat * 0.01;
            if (mpoly.contains({dLon, dLat}))
            {
                ret = std::max(ret, drp);
            }
        }
    }
    return ret;
}

std::vector<WarningRec> WxqWarns(std::map<int, std::map<int, double>>& lon2lat2drp)
{
    std::vector<WarningRec> warns;
    for (const auto& [code, grd2th] : WXQ2GRD2TH)
    {
        auto itInfo = WXQ2INFO.find(code);
        if (itInfo == WXQ2INFO.end())
            continue;

        auto [name, lon, lat] = itInfo->second;

        int xi = (int)std::round(lon * 100.0);
        int yi = (int)std::round(lat * 100.0);

        double drp = 0.0f;
        drp += lon2lat2drp[xi - 1][yi - 1];
        drp += lon2lat2drp[xi][yi - 1];
        drp += lon2lat2drp[xi + 1][yi - 1];
        drp += lon2lat2drp[xi - 1][yi];
        drp += lon2lat2drp[xi][yi];
        drp += lon2lat2drp[xi + 1][yi];
        drp += lon2lat2drp[xi - 1][yi + 1];
        drp += lon2lat2drp[xi][yi + 1];
        drp += lon2lat2drp[xi + 1][yi + 1];
        drp /= 9.0;

        if (drp == 0.0f)
            continue;

        if (grd2th.empty())
            continue;

        // python：thresholds[code]按threshold降序排序，匹配第一个 >= 阈值 即最高等级
        std::vector<std::pair<int, double>> rules;
        rules.reserve(grd2th.size());
        for (const auto& [grade, th] : grd2th)
            rules.emplace_back(grade, th);

        std::sort(rules.begin(), rules.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
        WarningRec ox;
        ox.CODE = code;
        ox.Lon = lon;
        ox.Lat = lat;
        ox.Name = std::get<0>(WXQ2INFO[code]);
        for (const auto& [grade, threshold] : rules)
        {
            if (drp >= threshold)
            {
                ox.WarnGradeID = grade;
                ox.Threshold = threshold;
                ox.WarningVal = drp;
                break;
            }
        }
        if (ox.WarnGradeID > 0)
        {
            warns.push_back(ox);
        }
    }
    return warns;
}