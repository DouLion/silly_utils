std::map<int, std::map<int, float>> GetDrpData(const std::time_t& tm)
{
    std::map<int, std::map<int, float>> ret;
    ReqParam param;
    sutime ptm(tm);
    param.btm = SUFMT("{:04d}-{:02d}-{:02d}%20{:02d}:{:02d}", ptm.year(), ptm.month(), ptm.day(), ptm.hour(), ptm.minute());
    param.etm = param.btm;

    suHttpClient cli;
    std::string resp;
    std::string url = URL;
    url.append("?").append(param.UrlFormat());
    SLOG_INFO("请求:{}", url)
    if (!cli.get(url, resp))
    {
        SLOG_ERROR(cli.err());
        return ret;
    }

    Json::Value jv = sujson::parse(resp);
    if (!jv.isObject())
    {
        SLOG_ERROR("JSON response is not an object");
        return ret;
    }

    // 检查状态码
    if (jv["status"].asInt() != 1 || !jv.isMember("data"))
    {
        std::string msg = jv.isMember("message") ? jv["message"].asString() : "unknown error";
        SLOG_ERROR("Radar API status error: {}", msg);
        return ret;
    }

    const Json::Value& data_arr = jv["data"];
    if (!data_arr.isArray())
    {
        SLOG_ERROR("Radar data is not an array");
        return ret;
    }

    for (const Json::Value& item : data_arr)
    {
        if (!item.isMember("lgtd") || !item.isMember("lttd") || !item.isMember("value"))
            continue;

        double lon = item["lgtd"].asDouble();
        double lat = item["lttd"].asDouble();
        float rainfall = item["value"].asFloat() * SCALE;

        int lon_key = static_cast<int>(std::round(lon * 100.0));
        int lat_key = static_cast<int>(std::round(lat * 100.0));

        // 保存最大值
        auto& inner_map = ret[lon_key];
        auto it = inner_map.find(lat_key);
        if (it == inner_map.end() || rainfall > it->second)
        {
            inner_map[lat_key] = rainfall;
        }
    }

    // 可选：记录解析条目数
    SLOG_INFO("Successfully parsed {} radar items", data_arr.size())

    return ret;
}