std::map<std::string, int> RecentWarn2Grade(const std::time_t& tm)
{
    std::map<std::string, int> ret;
    auto tmp = CONN;
    std::string sql = SUFMT("SELECT CODE, WarnGradeID  FROM WarnRecord_R  WHERE WarnSTM > '{}' AND WarnSTM <= '{}' AND WarnTypeID = 22;", TimeStringify(tm - 3 * SEC_IN_HOUR), TimeStringify(tm));
    if (!tmp.select(sql, [&ret](otl_stream* stm) {
            while (!stm->eof())
            {
                std::string code;
                int grade = 0;
                otl_read_row(*stm, code, grade);
                ret[code] = grade;
            }
        }))
    {
        SLOG_ERROR(tmp.err())
    }
    return ret;
}

void Insert(const std::vector<WarningRec>& records, const std::time_t& base_time)
{
    auto tmp = CONN;
    std::string sql =
        " INSERT INTO WarnRecord_R  (CODE, WarnTypeID, WarnGradeID, WarnStatusID, WarnSTM, WarnNM, WarnDesc, Threshold, WarningVal, GenTM)VALUES(:f1<char[32]>, 22,:f2<int>, 0, :f3<timestamp>, :f4<char[256]>, :f5<varchar_long>, :f6<double>, :f7<double>, "
        "NOW());";
    if (!tmp.insert(sql, [records, base_time](otl_stream* stm) {
            otl_datetime tm = suOTL::Stamp2Time(base_time);
            for (const auto& r : records)
            {
                otl_write_row(*stm, r.CODE, r.WarnGradeID, tm, r.WarnNM, r.WarnDesc, r.Threshold, r.WarningVal);
            }
        }))
    {
        SLOG_ERROR(tmp.err())
    }
}

void Process()
{
    const int TIME_SPAN = 5 * 60;
    std::time_t now = std::time(nullptr) - TIME_SPAN * 3;  // 往前倒一会儿, 防止数据延迟
    now = now / TIME_SPAN * TIME_SPAN;                     // 取整5分钟
    std::map<int, std::map<int, float>> lon2lat2drp = GetDrpData(now);
    std::vector<WarningRec> potential_warnings;
    for (const auto& [code, grd2th] : WXQ2GRD2TH)
    {
        auto itInfo = WXQ2INFO.find(code);
        if (itInfo == WXQ2INFO.end())
            continue;

        auto [name, lon, lat] = itInfo->second;

        int xi = (int)std::round(lon * 100.0);
        int yi = (int)std::round(lat * 100.0);

        float drp = 0.0f;
        drp += lon2lat2drp[xi - 1][yi - 1];
        drp += lon2lat2drp[xi][yi - 1];
        drp += lon2lat2drp[xi + 1][yi - 1];
        drp += lon2lat2drp[xi - 1][yi];
        drp += lon2lat2drp[xi][yi];
        drp += lon2lat2drp[xi + 1][yi];
        drp += lon2lat2drp[xi - 1][yi + 1];
        drp += lon2lat2drp[xi][yi + 1];
        drp += lon2lat2drp[xi + 1][yi + 1];
        drp /= 9.0;

        if (drp == 0.0f)
            continue;

        if (grd2th.empty())
            continue;

        // python：thresholds[code]按threshold降序排序，匹配第一个 >= 阈值 即最高等级
        std::vector<std::pair<int, double>> rules;
        rules.reserve(grd2th.size());
        for (const auto& [grade, th] : grd2th)
            rules.emplace_back(grade, th);

        std::sort(rules.begin(), rules.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
        WarningRec ox;
        ox.CODE = code;
        for (const auto& [grade, threshold_val] : rules)
        {
            if ((double)drp >= threshold_val)
            {
                ox.WarnGradeID = grade;
                ox.Threshold = threshold_val;
                ox.WarningVal = drp;
                break;
            }
        }
        if (ox.WarnGradeID > 0)
        {
            potential_warnings.push_back(ox);
        }
    }

    if (potential_warnings.empty())
    {
        SLOG_INFO("当前无预警产生。")
        return;
    }

    // python：filter_recent_warnings(conn, potential_warnings, base_time)
    std::map<std::string, int> recent_keys = RecentWarn2Grade(now);

    std::vector<WarningRec> final_warnings;
    final_warnings.reserve(potential_warnings.size());
    for (auto& warn : potential_warnings)
    {
        if (warn.WarnGradeID > recent_keys[warn.CODE])
        {
            std::string wxqNm = std::get<0>(WXQ2INFO[warn.CODE]);
            std::string grdNm = GRADE_NAME_MAP[warn.WarnGradeID];
            warn.WarnNM = SUFMT("{}{}", wxqNm, grdNm);
            // "%Y-%m-%d %H:%M
            warn.WarnDesc = SUFMT(TEMPLATE, wxqNm, TimeStringify(now, "%Y年%m月%d日%H时%M分"), warn.WarningVal, grdNm, warn.Threshold, warn.WarningVal - warn.Threshold);
            final_warnings.push_back(warn);
        }
    }

    SLOG_INFO("去重完毕，最终需入库 {}", final_warnings.size());
    Insert(final_warnings, now);
}

