void LoadDynamicRule(const std::time_t& tm)
{
    std::time_t target = tm / SEC_IN_HOUR * SEC_IN_HOUR;  // 取整点
    std::cout << TimeStringify(target) << std::endl;
    auto func = [](std::time_t tm2) -> std::map<int, std::map<std::string, std::map<int, double, std::greater<int>>>> {
        std::map<int, std::map<std::string, std::map<int, double, std::greater<int>>>> ret;
        suHttpClient cil;
        std::string sTM = TimeStringify(tm2, "%Y-%m-%d %H:%M");
        sTM = REPLACE(sTM, " ", "%20");
        std::string url = SUFMT(URL, sTM);
        std::string resp;
        SLOG_INFO(url)
        if (!cil.get(url, resp))
        {
            SLOG_ERROR(cil.err())
            return ret;
        }

        Json::Value jv = sujson::parse(resp);
        int num = 0;
        if (jv.isObject() && jv.isMember("data") && jv["data"].isObject())
        {
            auto& jvData = jv["data"];
            for (const auto& code : jvData.getMemberNames())
            {
                for (const auto& sintv : jvData[code].getMemberNames())
                {
                    for (const auto& sgrd : jvData[code][sintv].getMemberNames())
                    {
                        double th = jvData[code][sintv][sgrd].asDouble();
                        if (th < 15)  // 忽略一些异常值
                        {
                            continue;
                        }
                        try
                        {
                            ret[std::stoi(sintv)][code][std::stoi(sgrd)] = th;
                            num++;
                        }
                        catch (...)
                        {
                        }
                    }
                }
            }
        }
        SLOG_INFO("指标数量: {}", num)
        return ret;
    };
    auto tmp = func(target);
    if (tmp.empty())
    {
        target -= SEC_IN_HOUR;
        tmp = func(target);
    }

    if (tmp.empty())
    {
        return;
    }
    std::swap(INTV2WXQ2GRD2TH, tmp);
}