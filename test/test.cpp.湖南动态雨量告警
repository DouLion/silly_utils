std::map<int, std::map<std::string, double>> GetDrpData(const std::time_t& tm)
{
    std::map<int, std::map<std::string, double>> ret;

    std::time_t ntm = tm / SEC_IN_HOUR * SEC_IN_HOUR;
    if (tm - ntm > 300)
    {
        ntm += SEC_IN_HOUR;
    }
    std::map<std::string, std::map<std::time_t, double>> stcd2tm2drp;
    std::string _FMT = R"(SELECT STCD, TM, DRP FROM RWDB_HUNAN.ST_PPTN_R WHERE DRP > 0 AND TM > '{}' AND TM <= '{}')";
    std::string sql = SUFMT(_FMT, TimeStringify(tm - 6 * SEC_IN_HOUR), TimeStringify(ntm));
    auto tmp = CONN;
    if (!tmp.select(sql, [&stcd2tm2drp](otl_stream* stm) {
            while (!stm->eof())
            {
                std::string stcd;
                otl_datetime odt;
                double drp;
                otl_read_row(*stm, stcd, odt, drp);
                stcd2tm2drp[stcd][suOTL::Time2Stamp(odt)] = drp;
            }
        }))
    {
        SLOG_ERROR(tmp.err())
        return ret;
    }
    SLOG_INFO("降雨记录数:{}", stcd2tm2drp.size())
    const std::map<int, std::time_t> INTV2STAMP = {
        {1, tm - SEC_IN_HOUR},
        {3, tm - 3 * SEC_IN_HOUR},
        {6, tm - 6 * SEC_IN_HOUR},
    };

    for (const auto& [stcd, stamp2drp] : stcd2tm2drp)
    {
        for (const auto& [stamp, drp] : stamp2drp)
        {
            for (auto [intv, minStamp] : INTV2STAMP)
            {
                if (stamp > minStamp)
                {
                    ret[intv][stcd] += drp;
                }
            }
        }
        
    }
    return ret;
}

std::map<std::string, int> RecentWarn2Grade(const std::time_t& tm)
{
    std::map<std::string, int> ret;
    auto tmp = CONN;
    std::string sql = SUFMT("SELECT CODE, WarnGradeID  FROM WarnRecord_R  WHERE WarnSTM > '{}' AND WarnSTM <= '{}' AND WarnTypeID = 21;", TimeStringify(tm - 3 * SEC_IN_HOUR), TimeStringify(tm));
    if (!tmp.select(sql, [&ret](otl_stream* stm) {
            while (!stm->eof())
            {
                std::string code;
                int grade = 0;
                otl_read_row(*stm, code, grade);
                ret[code] = std::max(ret[code], grade);
            }
        }))
    {
        SLOG_ERROR(tmp.err())
    }
    return ret;
}

