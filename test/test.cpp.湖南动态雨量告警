void Insert(const std::vector<WarnRecord>& records, const std::time_t& base_time)
{
    auto tmp = CONN;
    std::string sql = R"(
INSERT INTO WarnRecord_R 
( CODE, WarnTypeID, WarnGradeID, WarnStatusID, WarnSTM, WarnNM, WarnDesc, Threshold, WarningVal, INTV, GenTM)
VALUES
(:f1<char[32]>, 21,:f2<int>, 0, :f3<timestamp>, :f4<char[256]>, :f5<varchar_long>, :f6<double>, :f7<double>, :f8<int>, NOW());
)";
    if (!tmp.insert(sql, [records, base_time](otl_stream* stm) {
            otl_datetime tm = suOTL::Stamp2Time(base_time);
            for (const auto& r : records)
            {
                otl_write_row(*stm, r.CODE, r.WarnGradeID, tm, r.WarnNM, r.WarnDesc, r.Threshold, r.WarningVal, r.INTV);
            }
        }))
    {
        SLOG_ERROR(tmp.err())
    }
}

void Process()
{
    std::time_t now = std::time(nullptr);
    std::map<int, std::map<std::string, double>> intv2stcd2drp = GetDrpData(now);
    LoadDynamicRule(now);
    if (INTV2WXQ2GRD2TH.empty())
    {
        SLOG_ERROR("指标为空")
        return;
    }
    std::map<std::string, WarnRecord> code2record;
    for (const auto& [intv, code2grd2th] : INTV2WXQ2GRD2TH)
    {
        for (const auto& [code, grd2th] : code2grd2th)
        {
            if (!HAS(WXQ2STCD2W, code) || !HAS(WXQ2NAME, code))
            {
                continue;
            }

            WarnRecord tmp;
            for (const auto& [stcd, w] : WXQ2STCD2W.at(code))
            {
#if 1
                tmp.WarningVal = std::max(tmp.WarningVal, intv2stcd2drp[intv][stcd]);  // 使用最大降雨站数据
               
#else
                tmp.WarningVal += intv2stcd2drp[intv][stcd] * w;
#endif
            }
           
            tmp.CODE = code;
            tmp.INTV = intv;
            for (const auto& [grd, th] : grd2th)
            {
                if ((double)tmp.WarningVal >= th)
                {
                    tmp.WarnGradeID = grd;
                    tmp.Threshold = th;
                    break;
                }
            }
            if (tmp.WarnGradeID == 0)
            {
                continue;
            }
            if (!HAS(code2record, tmp.CODE))
            {
                code2record[code] = tmp;
                continue;
            }

            // 同批次有其他告警
            // 告警等级越大优先级最高, 其次intv越小优先级越高
            auto& other = code2record[code];
            if (tmp.WarnGradeID > other.WarnGradeID)
            {
                code2record[code] = tmp;
                continue;
            }
            if (tmp.WarnGradeID == other.WarnGradeID)
            {
                if (tmp.INTV < other.INTV)
                {
                    code2record[code] = tmp;
                }
            }
        }
    }

    if (code2record.empty())
    {
        SLOG_INFO("当前无预警产生。")
        return;
    }
    std::map<std::string, int> code2grd = RecentWarn2Grade(now);

    // 如果最近一段时间产生过告警, 等级不提示就不重复预警
    std::vector<WarnRecord> records;
    std::string TMFMT = "%m月%d日%H时%M分";
    std::string recordTM = TimeStringify(now, TMFMT);
    for (auto& [code, r] : code2record)
    {
        if (r.WarnGradeID > code2grd[code])
        {
            std::string wxqNm = std::get<1>(WXQ2NAME[code]);
            std::string grdNm = GRADE_NAME_MAP[r.WarnGradeID];
            r.WarnNM = SUFMT("{}{}", std::get<0>(WXQ2NAME[code]), grdNm);  // 告警名称中使用简称, 告警描述中使用全称
            
            r.WarnDesc = SUFMT(TEMPLATE, recordTM, wxqNm, r.INTV, r.WarningVal, grdNm, r.Threshold, r.WarningVal - r.Threshold);
            // SLOG_INFO(r.WarnDesc)
            records.push_back(r);
        }
    }

    SLOG_INFO("去重完毕，最终需入库 {}", records.size());
    if (records.empty())
    {
        return;
    }
    Insert(records, now);
}

