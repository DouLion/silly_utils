message("\n检查库 jsoncpp")

if(DISABLE_JSONPP)
    message(STATUS "禁用jsoncpp")
else()
    find_package(jsoncpp CONFIG)
    if(jsoncpp_FOUND)
        message(STATUS "jsoncpp found: ${jsoncpp_FOUND}")
        message(STATUS "jsoncpp version: ${jsoncpp_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES JsonCpp::JsonCpp)
        set(SU_THIRD_SUPPORT_JSONPP 1)
    else()
        message(WARNING "未发现jsoncpp")
    endif()
endif()