message("\n检查库 Freetype")
if(DISABLE_FREE_TYPE)
    message(STATUS "禁用Freetype")
else()
    find_package(Freetype CONFIG)
    if(Freetype_FOUND)
        message(STATUS "Freetype found: ${Freetype_FOUND}")
        message(STATUS "Freetype version: ${Freetype_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES Freetype::Freetype)
        set(SU_THIRD_SUPPORT_FREE_TYPE 1)
    else()
        message(WARNING "未发现Freetype")
    endif()
endif()
