message("\n检查库 CGAL")

if(DISABLE_CGAL)
    message(STATUS "禁用CGAL")
else()
    find_package(CGAL CONFIG)
    if(CGAL_FOUND)
        message(STATUS "CGAL found: ${CGAL_FOUND}")
        message(STATUS "CGAL version: ${CGAL_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES CGAL::CGAL)
        set(SU_THIRD_SUPPORT_CGAL 1)
    else()
        message(WARNING "未发现CGAL")
    endif()
endif()