message("\n检查库 PAHO_MQTT")
if(DISABLE_PAHO_MQTT)
    message(STATUS "禁用PAHO_MQTT")
else()
    find_package(PahoMqttCpp CONFIG)
    if(PahoMqttCpp_FOUND)
        message(STATUS "PahoMqttCpp found: ${PahoMqttCpp_FOUND}")
        message(STATUS "PahoMqttCpp version: ${PahoMqttCpp_VERSION}")
        if(IS_LINUX)
            list(APPEND SU_ALL_REQUIRED_LIBRARIES PahoMqttCpp::paho-mqttpp3-static)
        else()
            list(APPEND SU_ALL_REQUIRED_LIBRARIES PahoMqttCpp::paho-mqttpp3)
        endif()
        set(SU_THIRD_SUPPORT_PAHO_MQTT 1)
    else()
        message(WARNING "未发现PAHO_MQTT")
    endif()
endif()