message("\n检查库 netCDFCxx")
if(DISABLE_NETCDF_CXX)
    message(STATUS "禁用netCDFCxx")
else()
    find_package(netCDFCxx CONFIG REQUIRED)
    if(netCDFCxx_FOUND)
        message(STATUS "netCDFCxx found: ${netCDFCxx_FOUND}")
        message(STATUS "netCDFCxx version: ${netCDFCxx_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES netCDF::netcdf netCDF::netcdf-cxx4)
        set(SU_THIRD_SUPPORT_NETCDF_CXX 1)
    else()
        message(WARNING "未发现netCDFCxx")
    endif()
endif()