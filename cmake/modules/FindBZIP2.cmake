message("\n检查库 BZip2")
if(DISABLE_BZIP2)
    message(STATUS "禁用BZip2")
else()
    find_package(BZip2)
    if(BZip2_FOUND)
        message(STATUS "BZip2 found: ${BZip2_FOUND}")
        message(STATUS "BZip2 version: ${BZip2_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES BZip2::BZip2)
        set(SU_THIRD_SUPPORT_BZIP2 1)
    else()
        message(WARNING "未发现BZip2")
    endif()
endif()