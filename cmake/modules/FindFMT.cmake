message("\n检查库 FMT")
if(DISABLE_FMT)
    message(STATUS "禁用FMT")
else()
    find_package(fmt CONFIG)
    if(fmt_FOUND)
        message(STATUS "FMT found: ${fmt_FOUND}")
        message(STATUS "FMT version: ${fmt_VERSION}")
        list(APPEND SU_ALL_REQUIRED_LIBRARIES fmt::fmt)
        set(SU_THIRD_SUPPORT_FMT 1)
    else()
        message(WARNING "未发现FMT")
    endif()
endif()